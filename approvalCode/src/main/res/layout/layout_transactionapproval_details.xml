<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.imageview.ShapeableImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.5"
        android:scaleType="centerCrop"
        android:src="@drawable/caslogo" />

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"/>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mcv_details"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardElevation="5dp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintBottom_toTopOf="@+id/btn_disapprove"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.9"
        app:layout_constraintHeight_percent="0.8">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/colorPrimary"
                    android:layout_margin="10dp"
                    android:padding="15dp">

                    <LinearLayout
                        android:id="@+id/layout_master"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintWidth_percent="0.6">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Transaction No"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:alpha="0.7"/>

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/mtv_transactno"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="N/A"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold"/>

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/mtv_dtransact"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="1900-01-01 00:00:00"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:alpha="0.6"
                            android:textStyle="bold"
                            android:layout_marginTop="5dp"/>

                    </LinearLayout>

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/HeaderLabelBlack"
                        android:id="@+id/mtv_status"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:text="N/A"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:alpha="0.75"
                        android:gravity="center"
                        app:layout_constraintTop_toTopOf="@+id/layout_master"
                        app:layout_constraintBottom_toBottomOf="@+id/layout_master"
                        app:layout_constraintStart_toEndOf="@+id/layout_master"
                        app:layout_constraintEnd_toEndOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/btn_view_attachment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="View Attachments"
                android:textColor="?attr/colorPrimary"
                android:gravity="end"
                android:paddingHorizontal="10dp"
                android:paddingBottom="10dp"/>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="10dp"
                android:paddingVertical="10dp"
                android:fillViewport="true">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    
                    <LinearLayout
                        android:id="@+id/layout_labels"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintWidth_percent="0.25">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Source No:"
                            android:textSize="12sp"
                            android:textStyle="bold"/>

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Recipient:"
                            android:textSize="12sp"
                            android:textStyle="bold"/>

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Industry:"
                            android:textSize="12sp"
                            android:textStyle="bold"/>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_values"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:layout_constraintWidth_percent="0.35"
                        app:layout_constraintStart_toEndOf="@+id/layout_labels"
                        android:orientation="vertical">

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/mtv_sourceno"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="N/A"
                            android:textSize="12sp"
                            android:maxLines="1"
                            android:paddingStart="5dp"/>

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/mtv_recipient"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="N/A"
                            android:textSize="12sp"
                            android:maxLines="1"
                            android:paddingStart="5dp"/>

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/mtv_industry"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="N/A"
                            android:textSize="12sp"
                            android:maxLines="1"
                            android:paddingStart="5dp"/>

                    </LinearLayout>

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/mtv_source"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:text="N/A"
                        android:textSize="12sp"
                        android:textStyle="italic"
                        android:gravity="center_horizontal"
                        app:layout_constraintStart_toEndOf="@+id/layout_values"
                        app:layout_constraintTop_toTopOf="@+id/layout_labels"
                        app:layout_constraintBottom_toBottomOf="@+id/layout_values"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/mtv_remarks"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:paddingVertical="10dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/layout_values"/>
                    
                </androidx.constraintlayout.widget.ConstraintLayout>

            </ScrollView>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_disapprove"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Disapprove"
        android:layout_marginTop="5dp"
        android:backgroundTint="@color/cross_red"
        android:textColor="@color/white"
        android:layout_marginBottom="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/mcv_details"
        app:layout_constraintWidth_percent="0.35"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_approve"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Approve"
        android:textColor="@color/white"
        app:layout_constraintTop_toTopOf="@+id/btn_disapprove"
        app:layout_constraintBottom_toBottomOf="@+id/btn_disapprove"
        app:layout_constraintEnd_toEndOf="@+id/mcv_details"
        app:layout_constraintWidth_percent="0.35"/>

</androidx.constraintlayout.widget.ConstraintLayout>