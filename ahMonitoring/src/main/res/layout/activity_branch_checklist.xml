<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".Activity.Activity_Branch_Visit_Checklist">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/GhostRiderMaterialTheme.AppBarOverlay">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:popupTheme="@style/GhostRiderMaterialTheme.PopupOverlay" />

    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:id="@+id/frame_record"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/mcv_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="10dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="10dp">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/mtv_branch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="N/A"
                        android:textAppearance="@style/HeaderLabelBlack"
                        android:gravity="center"
                        android:paddingVertical="10dp"/>

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/mtv_transactionno"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="N/A"
                        android:textSize="12sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/mtv_branch"
                        app:layout_constraintWidth_percent="0.65"/>

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/mtv_status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="N/A"
                        android:textSize="12sp"
                        app:layout_constraintStart_toStartOf="@+id/mtv_transactionno"
                        app:layout_constraintEnd_toEndOf="@+id/mtv_transactionno"
                        app:layout_constraintTop_toBottomOf="@+id/mtv_transactionno"/>

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/mtv_date"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="1900-00-00"
                        android:gravity="end"
                        android:textSize="12sp"
                        app:layout_constraintTop_toBottomOf="@+id/mtv_branch"
                        app:layout_constraintStart_toEndOf="@+id/mtv_transactionno"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/mtv_send"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Unknown"
                        android:gravity="end"
                        android:textSize="12sp"
                        app:layout_constraintStart_toEndOf="@+id/mtv_status"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/mtv_date" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/mcv_details"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="5dp"
                app:cardElevation="10dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerview_checklist"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:padding="10dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@+id/btn_submit"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_submit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="SUBMIT"
                        android:layout_margin="10dp"
                        android:layout_gravity="bottom"
                        android:enabled="false"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_imgPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/img_selfie"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/app_background_dark"
                android:scaleType="centerCrop"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_imgInfo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:elevation="15dp"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    app:cardElevation="10dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintHeight_percent="0.065">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <ImageButton
                            android:id="@+id/btn_close"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:src="@android:drawable/ic_menu_close_clear_cancel"
                            android:backgroundTint="@color/zxing_transparent"/>

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/mtv_category"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="N/A"
                            android:gravity="center_vertical"
                            android:paddingStart="10dp"
                            android:textSize="18sp"/>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardElevation="10dp"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="20dp">

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/mtv_imgNm"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="N/A"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:layout_constraintWidth_percent="0.7"/>

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/mtv_imgDate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="1900-00:00 00:00:00"
                            android:textSize="12sp"
                            app:layout_constraintTop_toBottomOf="@+id/mtv_imgNm"
                            app:layout_constraintWidth_percent="0.7"/>

                        <ImageButton
                            android:id="@+id/btn_upload"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/baseline_cloud_upload_24"
                            android:background="@color/zxing_transparent"
                            app:layout_constraintStart_toEndOf="@+id/mtv_imgNm"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@+id/mtv_imgNm"
                            app:layout_constraintBottom_toBottomOf="@+id/mtv_imgDate"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </FrameLayout>

    <LinearLayout
        android:id="@+id/layout_noRecord"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        android:gravity="center"
        android:layout_gravity="center">

        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/kay"
            android:alpha="0.3"/>

        <com.google.android.material.textview.MaterialTextView
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:textSize="18dp"
            android:fontFamily="@font/roboto_medium"
            android:text="No record found"
            android:alpha="0.4"/>

    </LinearLayout>

</LinearLayout>