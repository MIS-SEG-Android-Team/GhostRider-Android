<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="10dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/mtv_branch"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="N/A"
        android:textStyle="bold"
        android:paddingHorizontal="10dp"
        app:layout_constraintWidth_percent="0.6"/>


    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/mtv_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Unknown"
        android:textStyle="bold"
        android:gravity="end"
        android:paddingEnd="10dp"
        app:layout_constraintTop_toTopOf="@+id/mtv_branch"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@+id/mtv_branch"
        app:layout_constraintStart_toEndOf="@+id/mtv_branch"/>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/mtv_transno"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="N/A"
        android:layout_marginBottom="10dp"
        android:textSize="12sp"
        android:paddingHorizontal="10dp"
        app:layout_constraintTop_toBottomOf="@+id/mtv_branch"
        app:layout_constraintStart_toStartOf="@+id/mtv_branch"
        app:layout_constraintEnd_toEndOf="@+id/mtv_branch"/>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/mtv_date"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="1900-00-00"
        android:gravity="end"
        android:textSize="12sp"
        android:paddingEnd="10dp"
        app:layout_constraintStart_toEndOf="@+id/mtv_transno"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/mtv_transno"
        app:layout_constraintBottom_toBottomOf="@+id/mtv_transno"/>

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/guanzon_dark_grey"
        android:layout_marginTop="10dp"
        app:layout_constraintHeight_percent="0.009"
        app:layout_constraintTop_toBottomOf="@+id/mtv_transno"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>