<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="10dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/siv_icon"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitCenter"
        android:src="@drawable/baseline_error_24"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/mtv_filename"
        app:layout_constraintBottom_toBottomOf="@+id/mtv_filepath"
        app:layout_constraintWidth_percent="0.15"/>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/mtv_filename"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="N/A"
        android:textSize="15sp"
        android:paddingStart="12dp"
        app:layout_constraintStart_toEndOf="@+id/siv_icon"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/mtv_filepath"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="N/A"
        android:textSize="12sp"
        android:paddingStart="12dp"
        app:layout_constraintStart_toEndOf="@+id/siv_icon"
        app:layout_constraintTop_toBottomOf="@+id/mtv_filename"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>