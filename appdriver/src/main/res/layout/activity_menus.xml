<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/banner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardElevation="10dp"
        app:cardCornerRadius="8dp"
        app:cardUseCompatPadding="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <!-- Left side: Title + Info + Description -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_vertical">

                    <com.google.android.material.textview.MaterialTextView
                        android:backgroundTint="#f67321"
                        android:id="@+id/title1"
                        android:gravity="end"
                        android:textColor="@color/black"
                        android:padding="5dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="COMPANY RULES"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="4dp"/>

                    <com.google.android.material.textview.MaterialTextView
                        android:backgroundTint="#f67321"
                        android:id="@+id/title2"
                        android:gravity="end"
                        android:textColor="@color/black"
                        android:padding="5dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="AND REGULATIONS"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="4dp"/>

                </LinearLayout>

            </LinearLayout>

            <!-- Right side: Image -->
            <ImageView
                android:id="@+id/cardImage"
                android:layout_width="120dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/kayscope" />
        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/layout_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/banner">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/mcv_item1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardCornerRadius="10dp"
            app:cardElevation="10dp"
            app:cardUseCompatPadding="true">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="160dp"
                android:layout_height="180dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/file_icon1"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:src="@drawable/outline_book_5_24"
                    android:scaleType="fitCenter"
                    android:background="@color/zxing_transparent"
                    app:layout_constraintWidth_percent="0.5"
                    app:layout_constraintHeight_percent="0.5"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/file_title1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="SUMMARY OF INFRACTIONS AND THEIR CORRESPONDING DISCIPLINARY ACTIONS"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_margin="10dp"
                    app:layout_constraintTop_toBottomOf="@+id/file_icon1"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>


            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/mcv_item2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardCornerRadius="10dp"
            app:cardElevation="10dp"
            app:cardUseCompatPadding="true">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="160dp"
                android:layout_height="180dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/file_icon2"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:src="@drawable/outline_book_5_24"
                    android:scaleType="fitCenter"
                    android:background="@color/zxing_transparent"
                    app:layout_constraintWidth_percent="0.5"
                    app:layout_constraintHeight_percent="0.5"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/file_title2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="TABLE OF OFFENSES AND ACTIONS"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_margin="10dp"
                    app:layout_constraintTop_toBottomOf="@+id/file_icon2"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>


            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_1">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/mcv_item3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardCornerRadius="10dp"
            app:cardElevation="10dp"
            app:cardUseCompatPadding="true">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="160dp"
                android:layout_height="180dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/file_icon3"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:src="@drawable/outline_book_5_24"
                    android:scaleType="fitCenter"
                    android:background="@color/zxing_transparent"
                    app:layout_constraintWidth_percent="0.5"
                    app:layout_constraintHeight_percent="0.5"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/file_title3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="DEFINITION OF DISCIPLINARY PROCEDURES"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_margin="10dp"
                    app:layout_constraintTop_toBottomOf="@+id/file_icon3"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>


            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btn_download"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        android:layout_marginEnd="20dp"
        android:src="@drawable/ic_baseline_file_download_24"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>