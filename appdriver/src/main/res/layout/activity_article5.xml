<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".Article5">
    <com.google.android.material.textfield.TextInputLayout
        style="@style/TextInputStyle"
        android:id="@+id/searchView1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="Find"
        android:padding="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.950">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/searchView"
            android:maxLines="1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:textSize="15sp"
            android:imeOptions="actionNext"
            android:drawablePadding="10dp"
            android:drawableTint="@color/footer_dark_grey"/>
    </com.google.android.material.textfield.TextInputLayout>
    <androidx.cardview.widget.CardView
        android:layout_below="@id/searchView1"
        android:id="@+id/banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:cardElevation="4dp"
        app:cardCornerRadius="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <!-- Left side: Title + Info + Description -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_vertical">

                    <TextView
                        android:backgroundTint="#f67321"
                        android:id="@+id/titles"
                        android:gravity="start"
                        android:textColor="@color/black"
                        android:padding="5dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Article 5\nAbsence without Official Leave (AWOL)"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="4dp"/>


                </LinearLayout>

                <TextView

                    android:justificationMode="inter_word"
                    android:id="@+id/description"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="4dp"
                    android:maxLines="3"
                    android:text="All employees are expected to report for work at all times. In case of emergency, the employee should notify his immediate supervisor two (2) hours before the said absence. Only accidents, death of immediate family members, confinement due to sickness are considered excused absences. All employees who were absent two (2) days and above due to sickness must submit a medical certificate to HCM Department prior to return to work.\n\nDue Process in Abandonment:\n\n(a) First Notice to apprise the employee of the particular acts or omissions for which his dismissal is sought; and\n\n(b) Second Notice to inform him of the employer’s decision to dismiss him on the ground of abandonment.\n\nFor obvious reasons, procedural due process in abandonment cases does not involve the conduct of hearing."
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/readMore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Read More"
                    android:textSize="12dp"
                    android:textColor="#f67321"
                    android:textStyle="bold"
                    android:gravity="center" />
            </LinearLayout>

            <!-- Right side: Image -->
            <ImageView
                android:id="@+id/cardImage"
                android:layout_width="120dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/article5" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <ExpandableListView

        android:groupIndicator="@null"
        android:layout_below="@id/banner"
        android:id="@+id/expandableListView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</RelativeLayout>
