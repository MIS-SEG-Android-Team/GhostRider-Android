<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginTop="10dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="10dp">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mtv_transnox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="N/A"
            android:textStyle="bold"
            app:layout_constraintWidth_percent="0.5"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mtv_dtransact"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="1900-00-00 00:00:00"
            android:gravity="center|end"
            app:layout_constraintTop_toTopOf="@+id/mtv_transnox"
            app:layout_constraintBottom_toBottomOf="@+id/mtv_transnox"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_percent="0.5"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mtv_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Unknown"
            app:layout_constraintTop_toBottomOf="@+id/mtv_transnox"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>