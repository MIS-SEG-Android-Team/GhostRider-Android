<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="10dp"
    android:elevation="10dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginVertical="10dp"
        android:padding="10dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtv_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="N/A"
                android:textStyle="bold"
                android:padding="10dp"
                android:maxLines="1"/>

            <RatingBar
                style="?attr/ratingBarStyle"
                android:id="@+id/rb_rate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:numStars="5"
                android:max="5"
                android:stepSize="0.5"
                android:layout_gravity="center"
                android:scaleX="1.3"
                android:scaleY="1.3"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_remarks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_search"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:hint="Remarks"
                    app:boxBackgroundColor="?attr/colorSurface"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/ib_check">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/tie_remarks"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:maxLines="1"/>

                </com.google.android.material.textfield.TextInputLayout>

                <ImageButton
                    android:id="@+id/ib_check"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:src="@drawable/baseline_check_24"
                    android:visibility="gone"
                    android:background="@color/zxing_transparent"
                    android:paddingHorizontal="10dp"
                    app:layout_constraintTop_toTopOf="@+id/layout_remarks"
                    app:layout_constraintBottom_toBottomOf="@+id/layout_remarks"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="end|center"
                android:padding="10dp">

                <ImageButton
                    android:id="@+id/ib_camera"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_camera_24"
                    android:scaleType="fitCenter"
                    android:background="@color/zxing_transparent"
                    android:layout_marginHorizontal="5dp"/>

                <ImageButton
                    android:id="@+id/ib_info"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:src="@drawable/baseline_info_grey"
                    android:scaleType="fitCenter"
                    android:background="@color/zxing_transparent"
                    android:paddingHorizontal="5dp"/>

            </LinearLayout>

        </LinearLayout>


    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>